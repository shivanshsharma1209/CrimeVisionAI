# CrimeVision AI - Environment Configuration

FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=crimevision-ai-super-secret-key-change-in-production

# Database (Default: SQLite, PostgreSQL compatible URI)
DATABASE_URL=sqlite:///crimevision.db

# Groq LLM API Key (Get free key at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI Models Configuration
RT_DETR_MODEL_PATH=rtdetr-l.pt
CUSTOM_WEAPON_MODEL_PATH=
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
BLIP_MODEL_NAME=Salesforce/blip-image-captioning-base
WHISPER_MODEL_NAME=base

# Video Sampling & Detection
VIDEO_SAMPLE_FPS=1.0
CONFIDENCE_THRESHOLD=0.35
MAX_UPLOAD_MB=500

# Demo Mode Enabled
ENABLE_DEMO_MODE=true
